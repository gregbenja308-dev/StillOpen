# Copy to `.env` and fill in. Never commit `.env`.
# Local fakes work with empty Gemini/OAuth. Token encryption key is required
# before we persist any OAuth refresh tokens.

# local  → JSON MemoryBank, FakeGoogle unless OAuth connected
# cloud  → Firestore + real Docs/Calendar + hash-only Watch fetch
STILLOPEN_ENV=local
STILLOPEN_SERVICE_NAME=stillopen

# Paste your existing AI Studio key (same one as Level). Do not commit it.
GOOGLE_API_KEY=

# New GCP project for Still Open (do not reuse Level's project).
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_REGION=us-central1

STILLOPEN_FAST_MODEL=gemini-3.5-flash
STILLOPEN_REASONING_MODEL=gemini-3.5-pro

# Fernet key for OAuth tokens at rest. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Leave empty to refuse token persistence (in-memory only).
STILLOPEN_TOKEN_KEY=

# Throwaway demo Google account. Scopes: drive.file, calendar.events.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:8080/v1/auth/google/callback
STILLOPEN_LIVE_GOOGLE=0
STILLOPEN_JOB_TOKEN=
STILLOPEN_FIRESTORE_DB=(default)

STILLOPEN_OTEL_EXPORTER=console
STILLOPEN_API_CORS_ORIGIN_REGEX=chrome-extension://.*
