# Copy to `.env` and fill in. Never commit `.env`.
# Local fakes work with empty Gemini.

# local  → JSON MemoryBank
# cloud  → Firestore + hash-only Watch fetch
STILLOPEN_ENV=local
STILLOPEN_SERVICE_NAME=stillopen

# Paste your existing AI Studio key (same one as Level). Do not commit it.
# Leave empty if you use Vertex (GCP credits) instead.
GOOGLE_API_KEY=

# GCP project for Vertex Gemini (hackathon credits). Not an AI Studio key.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_REGION=us-central1
# Gemini 3.5 Flash/Pro on Vertex live at `global`, not us-central1.
GOOGLE_CLOUD_LOCATION=global
# true = bill Gemini to the GCP project (ADC / Cloud Run SA). false = GOOGLE_API_KEY.
GOOGLE_GENAI_USE_VERTEXAI=false

# Cloud Trace in production. none locally — console dumps full LLM payloads.
STILLOPEN_OTEL_EXPORTER=none
# Optional Model Armor template id (inline guards always run).
STILLOPEN_MODEL_ARMOR_TEMPLATE=

STILLOPEN_FAST_MODEL=gemini-3.5-flash
STILLOPEN_REASONING_MODEL=gemini-3.5-pro

# Fernet key for encrypted secrets at rest. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
STILLOPEN_TOKEN_KEY=

# Cloud Scheduler only. Not a user setting — leave empty locally.
# In cloud, set once on Cloud Run + the Scheduler job header.
STILLOPEN_JOB_TOKEN=
STILLOPEN_FIRESTORE_DB=(default)

STILLOPEN_OTEL_EXPORTER=console
# Optional Model Armor template id. Empty = inline injection/PII guards only.
STILLOPEN_MODEL_ARMOR_TEMPLATE=
STILLOPEN_API_CORS_ORIGIN_REGEX=chrome-extension://.*
